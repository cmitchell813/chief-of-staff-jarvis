# Chief of Staff (Jarvis) — configuration
# Copy to your shell env or a launcher; all are optional with sensible defaults.

# Where the file-bridge lives (request/response/outputs folders).
# Default: ~/Documents/CoS-Bridge
COS_BRIDGE_ROOT=

# Voice used by macOS `say` for spoken replies. Download premium voices in
# System Settings > Accessibility > Spoken Content. Default: "Ava (Premium)"
COS_SAY_VOICE=Ava (Premium)

# Path to the Kiro CLI binary. Default: ~/.local/bin/kiro-cli
KIRO_CLI=

# Working directory the Kiro CLI runs in (your project root). Default: ~
KIRO_CWD=

# Path to the Open Design `od` CLI (optional — for the design shop feature).
OD_BIN=

# Open Design daemon URL override (optional).
OD_DAEMON_URL=
